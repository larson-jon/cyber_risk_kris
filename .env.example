# Copy this file to .env and fill in values. .env is gitignored.

# NIST NVD API key (optional but strongly recommended).
# Without a key you are limited to 5 requests / 30s; with a key, 50 / 30s.
# Request one free at: https://nvd.nist.gov/developers/request-an-api-key
# (NIST_API_KEY is also accepted as an alias.)
NVD_API_KEY=

# Directory where collected data is written (default: ./data)
DATA_DIR=data

# SEC EDGAR requires a descriptive User-Agent identifying who is making
# requests (e.g. "Acme Corp research jane.doe@acme.com"). Optional but polite;
# can also be passed with --user-agent on the edgar command.
EDGAR_USER_AGENT=
